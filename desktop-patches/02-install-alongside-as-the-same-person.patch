+
+  /*
+   * HEARTH: a way in to the circles made under earlier rules.
+   *
+   * When the rules change, the new version installs beside the old one rather
+   * than replacing it, so the conductor holds both. The circles somebody
+   * already has live in the older app, and the interface cannot see them
+   * without a token of its own for it.
+   *
+   * Returns one entry per earlier version of Hearth that is actually
+   * installed, newest first, so that the interface can list those circles,
+   * mark them as belonging to a version that is going away, and carry them
+   * across. See docs/upgrades.md in the Hearth repository.
+   */
+  async getEarlierAppTokens(): Promise<
+    Array<{ installedAppId: string; token: AppAuthenticationToken }>
+  > {
+    const installed = (await this.adminWebsocket.listApps({})).map(
+      (appInfo) => appInfo.installed_app_id
+    );
+
+    const tokens: Array<{ installedAppId: string; token: AppAuthenticationToken }> = [];
+    for (const installedAppId of HEARTH_PREVIOUS_APP_IDS) {
+      if (!installed.includes(installedAppId)) continue;
+      const response = await this.adminWebsocket.issueAppAuthenticationToken({
+        installed_app_id: installedAppId,
+        single_use: false,
+        expiry_seconds: 0,
+      });
+      tokens.push({ installedAppId, token: response.token });
+    }
+    return tokens;
+  }
 }
